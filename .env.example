# Supabase : Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé publique (« Publishable key » ou ancienne clé « anon »)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète (« Secret key » ou ancienne clé « service_role ») — serveur uniquement, jamais exposée au navigateur
SUPABASE_SERVICE_ROLE_KEY=
# Chaîne aléatoire protégeant la tâche planifiée quotidienne
CRON_SECRET=
